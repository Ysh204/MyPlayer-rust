{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPlayer Pro",
  "version": "1.0.0",
  "identifier": "com.yash.myplayer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyPlayer Pro",
        "width": 1280,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Yash Gaikwad",
    "copyright": "Copyright © 2026 Yash Gaikwad",
    "category": "Video",
    "shortDescription": "Minimalist high-performance desktop media player",
    "longDescription": "MyPlayer Pro is a razor-sharp, obsidian-glass desktop media player built with Tauri v2, Rust, and React.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
