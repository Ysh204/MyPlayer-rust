{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPlayer Pro",
  "version": "1.0.0",
  "identifier": "com.yash.myplayer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyPlayer Pro",
        "width": 1280,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  }
}
